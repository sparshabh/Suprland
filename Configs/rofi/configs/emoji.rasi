@import "/home/sparsha/.config/rofi/colors.rasi"

* {
    font: "JetbrainsMono Nerd Font 13";
    g-spacing: 10px;
    g-margin: 0;
    b-color: @surface;
    fg-color: @on-surface;
    fgp-color: @on-surface-variant;
    b-radius: 8px;
    g-padding: 8px;
    hl-color: @primary;
    hlt-color: @surface;
    wbg-color: @surface;
    w-border: 1px solid;
    w-border-color: @primary;
    w-padding: 20px;
}

configuration {
    modi: "dmenu";
    show-icons: true;
    display-drun: "Emojis";
    drun-display-format: "{name}";
}

listview {
    columns: 2;
    lines: 8;
    fixed-height: true;
    fixed-columns: true;
    cycle: false;
    scrollbar: false;
    border: 0px solid;
}

window {
    transparency: "real";
    width: 1500px;
    border-radius: @b-radius;
    background-color: @wbg-color;
    border: @w-border;
    border-color: @w-border-color;
    padding: @w-padding;
}

prompt {
    text-color: @fg-color;
}

inputbar {
    children: ["prompt", "entry"];
    spacing: @g-spacing;
}

entry {
    placeholder: "Search Emojis";
    text-color: @fg-color;
    placeholder-color: @fgp-color;
}

mainbox {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    children: ["inputbar", "listview", "message"];
}

element {
    spacing: @g-spacing;
    margin: @g-margin;
    padding: @g-padding;
    border: 0px solid;
    border-radius: @b-radius;
    border-color: @b-color;
    background-color: transparent;
    text-color: @fg-color;
}

element normal.normal {
	background-color: transparent;
	text-color: @fg-color;
}

element alternate.normal {
	background-color: transparent;
	text-color: @fg-color;
}

element selected.active {
	background-color: @hl-color;
	text-color: @hlt-color;
}

element selected.normal {
	background-color: @hl-color;
	text-color: @hlt-color;
}

message {
    background-color: @hl-color;
    text-color: @hlt-color;
    border: 0px solid;
}
